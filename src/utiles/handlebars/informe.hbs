<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Informe de Reservas</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-size: 11px; 
            margin: 40px;
            color: #333;
        }

        h1 {
            text-align: center;
            color: #2c3e50;
            border-bottom: 2px solid #2c3e50;
            padding-bottom: 10px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th {
            background-color: #2980b9;
            color: #fff;
            padding: 8px;
            text-align: left;
        }

        td {
            border-bottom: 1px solid #ccc;
            padding: 8px;
            word-break: break-word; 
        }

        tr:nth-child(even) {
            background-color: #f8f8f8;
        }

        .footer {
            text-align: center;
            font-size: 10px;
            margin-top: 40px;
            color: #777;
        }

    </style>
</head>
<body>
    <h1>📅 Informe de Reservas</h1>

    <table>
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Salón</th>
                <th>Turno</th>
                <th>Cliente</th>
                <th>Temática</th>
                <th>Total</th>
                <th>Servicios Contratados</th>
            </tr>
        </thead>
        <tbody>
            {{#each reservas}}
            <tr>
                <td>{{this.fecha_reserva}}</td>
                <td>{{this.salon}}</td>
                <td>{{this.turno}}</td>
                <td>{{this.cliente}}</td>
                <td>{{this.tematica}}</td>
                <td>{{this.importe_total}}</td>
                <td>{{this.servicios_contratados}}</td>
            </tr>
            {{/each}}
        </tbody>
    </table>

    <p class="footer">Programación III - © 2025 - Reservas de Casas de Cumpleaños
</p>
</body>
</html>